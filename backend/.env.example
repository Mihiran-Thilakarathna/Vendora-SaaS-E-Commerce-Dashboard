PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vendora
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# One-click demo access on the login page (uses the seeded accounts below)
DEMO_LOGIN_ENABLED=true
DEMO_ADMIN_EMAIL=admin@vendora.com
DEMO_STAFF_EMAIL=staff@vendora.com
# Passwords given to the demo accounts by `npm run seed`. Leave empty for the local defaults
# (Admin@123 / Staff@123), which are public: always set your own before seeding production.
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Optional: Google sign-in (OAuth Client ID from Google Cloud Console). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
